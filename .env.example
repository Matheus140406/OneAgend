# Banco de dados (Supabase Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneagend?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oneagend?schema=public"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_API_VERSION="v20.0"
WHATSAPP_TEMPLATE_LEMBRETE="lembrete_agendamento"
# App Secret do App da Meta (painel > Configuracoes do app > Basico), usado
# para validar a assinatura HMAC de cada notificacao do webhook (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=""
# Token que voce escolhe e cola no painel da Meta ao configurar a URL do
# webhook (usado so na verificacao inicial, GET com hub.verify_token)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Vercel Cron (protege o endpoint de lembretes)
CRON_SECRET=""

# Mercado Pago (cobranca recorrente via Assinaturas/Preapproval)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_API_BASE_URL="https://api.mercadopago.com"
# Chave secreta configurada em Suas integracoes > Webhooks, usada para validar o header x-signature
MERCADOPAGO_WEBHOOK_SECRET=""

# URL publica da aplicacao
NEXT_PUBLIC_APP_URL="http://localhost:3000"
