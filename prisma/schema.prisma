// OneAgend — schema multi-tenant de agendamento online
// Cada linha de negocio (Tenant) tem seus proprios profissionais, servicos,
// clientes e agendamentos. Nao ha compartilhamento de dados entre tenants.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  BASICO // 1 profissional
  ELITE // ate 5 profissionais
  PLATINA // profissionais ilimitados
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  CUSTOM
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  NO_SHOW
  DONE
}

// Nicho do tenant, usado para escolher o texto padrao das mensagens de
// WhatsApp (lembrete/confirmacao) sem exigir que o dono escreva do zero.
enum NicheType {
  BEAUTY_SALON
  HEALTH_CLINIC
  BARBERSHOP
  PETSHOP
  PERSONAL_TRAINER
  TATTOO_STUDIO
  THERAPY_CONSULTING
  SPORTS_COURT
}

// Idioma usado nas mensagens automaticas (WhatsApp) enviadas pelo tenant.
// Nao controla o idioma do painel (UI), so o conteudo dos templates.
enum Locale {
  PT_BR
  PT_PT
  EN
  ES
  FR
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  businessType String // tipo de negocio em texto livre, escolhido pelo dono
  plan         Plan     @default(BASICO)
  // timezone IANA usado para calcular expediente/folgas (ex: America/Sao_Paulo)
  timezone     String   @default("America/Sao_Paulo")

  // Nicho estruturado (alem do businessType livre) usado para escolher o
  // template padrao de mensagem de WhatsApp. Idioma dessas mensagens.
  niche NicheType @default(BARBERSHOP)
  locale Locale   @default(PT_BR)
  // phone_number_id da WhatsApp Cloud API deste tenant, se ele tiver o
  // proprio numero (embedded signup). Null = usa o numero da plataforma
  // (env WHATSAPP_CLOUD_API_PHONE_NUMBER_ID), compartilhado entre tenants.
  whatsappPhone    String?
  // Override do texto de mensagem escolhido pelo dono; se null, usa o
  // template padrao do niche (ver src/lib/whatsapp/niche-templates.ts).
  whatsappTemplate String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription  Subscription?
  users         User[]
  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([slug])
  @@index([whatsappPhone])
}

model Subscription {
  id                       String             @id @default(cuid())
  tenantId                 String             @unique
  tenant                   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                     Plan
  status                   SubscriptionStatus @default(TRIALING)
  // id da assinatura recorrente (Preapproval) no Mercado Pago
  mercadoPagoPreapprovalId String?            @unique
  currentPeriodEnd         DateTime?
  // fim do teste gratis de 7 dias, definido na criacao do Tenant
  trialEndsAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

// User.id é o mesmo id do usuario no Supabase Auth (auth.users.id)
model User {
  id             String        @id
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String        @unique
  name           String
  role           UserRole      @default(OWNER)
  professionalId String?       @unique
  professional   Professional? @relation(fields: [professionalId], references: [id])

  // Permissoes granulares (checadas por src/lib/auth/rbac.ts). Role=OWNER
  // ignora essas flags (bypass total). Para os demais papeis, cada acao
  // sensivel exige a flag correspondente — CUSTOM depende inteiramente
  // delas, ADMIN/STAFF podem ter defaults diferentes na criacao do usuario.
  canViewFinancial     Boolean @default(false)
  canManageScheduleAll Boolean @default(false)
  canManageClients     Boolean @default(true)
  canManageSettings    Boolean @default(false)
  canTriggerBroadcast  Boolean @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
}

model Professional {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user         User?
  workingHours WorkingHour[]
  timeOffs     TimeOff[]
  services     ServiceOnProfessional[]
  appointments Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
}

// Expediente semanal recorrente do profissional.
// weekday: 0 = domingo ... 6 = sabado (mesma convencao de Date#getDay em America/Sao_Paulo)
model WorkingHour {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"

  @@index([professionalId, weekday])
}

// Bloqueio/folga pontual do profissional (ferias, atestado, compromisso, etc).
model TimeOff {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String?

  @@index([professionalId, startsAt, endsAt])
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  professionals ServiceOnProfessional[]
  appointments  Appointment[]
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
}

// Vinculo N:N entre profissionais e servicos que cada um executa.
model ServiceOnProfessional {
  serviceId      String
  professionalId String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([professionalId])
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  whatsapp  String // formato E.164, ex: +5511999999999
  // Cliente pediu para nao receber mensagens automaticas (broadcast/waitlist).
  // Lembretes de agendamento continuam valendo (nao sao marketing).
  whatsappOptOut Boolean @default(false)
  createdAt DateTime @default(now())

  appointments   Appointment[]
  waitlistEntries WaitlistEntry[]

  @@unique([tenantId, whatsapp])
  @@index([tenantId])
}

// Fila de espera para um servico (opcionalmente com profissional/data
// preferidos). Usada pela recuperacao de no-show: quando um agendamento e
// cancelado, avisamos os clientes elegiveis de que uma vaga abriu.
model WaitlistEntry {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professionalId   String?
  professional     Professional?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // "YYYY-MM-DD" opcional, no fuso do tenant — cliente so quer ser avisado se vagar nesse dia
  preferredDateKey String?
  status           WaitlistStatus @default(WAITING)

  // Preenchidos quando status vira NOTIFIED: o horario exato que vagou (do
  // agendamento cancelado que disparou o aviso) e ate quando o cliente pode
  // responder "SIM" para reivindicar. offeredProfessionalId e sempre
  // preenchido nesse momento, mesmo que professionalId acima seja null
  // (entrada generica "qualquer profissional").
  offeredStartsAt       DateTime?
  offeredEndsAt         DateTime?
  offeredProfessionalId String?
  offerExpiresAt        DateTime?
  notifiedAt             DateTime?
  createdAt        DateTime       @default(now())

  @@index([tenantId, serviceId, professionalId, status])
  @@index([clientId])
}

// Deduplica mensagens recebidas via webhook do WhatsApp (o id "wamid.*" da
// Meta e globalmente unico). A Graph API reenvia webhooks quando nao recebe
// 200 a tempo, entao sem isso um "2" (reagendar) processado duas vezes
// poderia, por exemplo, disparar a recuperacao de no-show em duplicidade.
model WhatsappInboundMessage {
  id          String   @id // wamid.* da Meta
  processedAt DateTime @default(now())
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING)

  // controle de idempotencia dos lembretes disparados pelo cron
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?

  rescheduleOffer RescheduleOffer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indice usado pela checagem de sobreposicao de horario (regra de negocio critica)
  @@index([professionalId, startsAt, endsAt])
  @@index([tenantId, startsAt])
  @@index([clientId])
}

// Oferta ativa de reagendamento: registrada quando o bot manda os 3
// horarios alternativos (resposta "2"), para que a PROXIMA mensagem do
// cliente seja interpretada como "escolhi a opcao N" em vez de cair de novo
// no menu confirmar/reagendar/cancelar. Expira sozinha (ver expiresAt);
// apagada assim que o cliente escolhe um horario ou manda outra coisa.
model RescheduleOffer {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  slotsOffered  DateTime[]
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
}

// Contador de rate limiting por janela fixa (chave = "<rota>:<identificador>:<janela>").
// Linhas de janelas antigas se acumulam; limpeza periodica pode ser feita depois se necessario.
model RateLimitHit {
  key       String   @id
  count     Int      @default(1)
  updatedAt DateTime @updatedAt
}
